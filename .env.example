# App
ENV=dev
APP_NAME="Hub Interbancario"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://hub:hub@localhost:5432/hub
DATABASE_ECHO=false

# JWT / OAuth2
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF_MINUTES=1,5,15

# Security
SIGNATURE_MAX_DRIFT_SECONDS=300

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=10